# ==============================================================
# DriveEase Vehicle Rental System - Environment Variables
# ==============================================================

PORT=5000
NODE_ENV=production

# Database Connection (Supabase PostgreSQL, MySQL, or SQLite)
# For Supabase PostgreSQL (Project: auevbqwytflxliaefcz):
# Connection String from Supabase Dashboard > Settings > Database:
DATABASE_URL=postgresql://postgres.auevbqwytflxliaefcz:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Alternatively, discrete parameters:
DB_HOST=db.auevbqwytflxliaefcz.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=[YOUR-PASSWORD]
DB_NAME=postgres

# If using local MySQL:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=vehicle_rental_db

# Supabase API details
SUPABASE_URL=https://auevbqwytflxliaefcz.supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]

# Security & Tokens
JWT_SECRET=driveease_jwt_secret_production_key_2026_secured
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
